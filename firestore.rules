rules_version = '2';

// ===============================================================
// S.A.B.U.P.C — Reglas de seguridad de Cloud Firestore (v1.1)
// Proyecto: sabupc-colima · Base de datos: (default)
// ===============================================================
//
// PROTOTIPO: revisar y probar en el emulador antes de producción.
//
// Modelo de datos asumido
// ---------------------------------------------------------------
// Colección: usuarios/{uid}   (ID del documento = UID de Firebase Auth)
//   Campos obligatorios base (28, retrocompatibles con v1.0):
//   - uid: string (== ID del documento, inmutable)
//   - correo: string (== request.auth.token.email al crear, inmutable)
//   - nombres: string 1..80                (editable por dueño Pendiente o Admin)
//   - apellido_paterno: string 1..60       (editable por dueño Pendiente o Admin)
//   - apellido_materno: string 0..60       (editable por dueño Pendiente o Admin)
//   - fecha_nacimiento: string 'AAAA-MM-DD' (10 caracteres; solo dueño Pendiente)
//   - sexo: 'Mujer' | 'Hombre' | 'Prefiero no decir' (solo dueño Pendiente)
//   - telefono_fijo: string 0..20          (editable por dueño Pendiente o Activo)
//   - celular: string 1..20                (editable por dueño Pendiente o Activo)
//   - celular_con_whatsapp: bool           (editable por dueño Pendiente o Activo)
//   - nivel_academico: 'Media Superior' | 'Superior' | 'Egresado' | 'Estudiante externo UdeC' (solo dueño Pendiente)
//   - escuela_carrera: string 1..120       (solo dueño Pendiente)
//   - numero_cuenta: string 1..12 ('0' si no aplica; editable por dueño Pendiente o Admin)
//   - tipo_sangre: 'O+' | 'O-' | 'A+' | 'A-' | 'B+' | 'B-' | 'AB+' | 'AB-'
//   - alergias: string 0..300
//   - padecimientos_medicamentos: string 0..500
//   - contacto_emergencia_nombre: string 1..120
//   - contacto_emergencia_telefono: string 1..20
//   - grupo_operativo: 'Alfa' | 'Omega' | 'Ninguno'                  (PRIVILEGIADO)
//   - ayudantia_slot: 'Capacitación' | 'Administración de Personal' |
//                     'Tesla' | 'Socorros' | 'Logística' | 'Ninguna'  (PRIVILEGIADO)
//   - rol_sistema: 'Brigadista' | 'Encargado' | 'Administrador'      (PRIVILEGIADO)
//   - autorizado_radio: bool                                         (PRIVILEGIADO)
//   - clave_personal_radio: string 1..10 | null                      (PRIVILEGIADO)
//   - estatus: 'Pendiente' | 'Activo' | 'Inactivo'                   (PRIVILEGIADO)
//   - qr_codigo_unico: string 1..64 | null                           (PRIVILEGIADO)
//   - tiene_foto: bool                                               (solo dueño Activo)
//   - creado_en: timestamp (inmutable)
//   - actualizado_en: timestamp (== request.time en cada escritura)
//   Campos opcionales v1.1 (jerarquía escalable y contacto de emergencia):
//   - etapa: 'Alfa' | 'Omega' | 'SIERRA' | 'Grupo Operativo'         (PRIVILEGIADO)
//   - subgrupo: string 0..60                                         (PRIVILEGIADO)
//   - ayudantia: 'Capacitación' | 'Administración de Personal' |
//                'Tesla' | 'Socorros' | 'Logística' | 'Ninguna'      (PRIVILEGIADO)
//   - grupos_a_cargo: list (<= 30 elementos)                         (PRIVILEGIADO)
//   - clave_radio: string 0..20 | null                               (PRIVILEGIADO)
//   - contacto_emergencia_parentesco: string 0..60                   (editable por dueño Pendiente o Activo)
//
// Colección: perfiles_operativos/{uid}   (proyección mínima sin PII médico)
//   Escritura por Admin Activo, Jefe de Ayudantía Activo (su ayudantía), o por el
//   propio titular sin privilegios en alta inicial / recuperación huérfana / estatus Pendiente.
//   - uid: string (== ID del documento, inmutable)
//   - nombre_completo: string 1..200
//   - numero_cuenta: string 1..12 (opcional)
//   - estatus: 'Pendiente' | 'Activo' | 'Inactivo'
//   - etapa: 'Alfa' | 'Omega' | 'SIERRA' | 'Grupo Operativo' | 'Ninguno' (opcional)
//   - subgrupo: string 0..60 | null (opcional)
//   - ayudantia: 'Capacitación' | 'Administración de Personal' |
//                'Tesla' | 'Socorros' | 'Logística' | 'Ninguna' (opcional)
//   - grupo_operativo: 'Alfa' | 'Omega' | 'Ninguno' (opcional)
//   - ayudantia_slot: 'Capacitación' | 'Administración de Personal' |
//                     'Tesla' | 'Socorros' | 'Logística' | 'Ninguna' (opcional)
//   - qr_codigo_unico: string 1..64 | null (opcional)
//   - clave_radio: string 0..20 | null (opcional)
//   - actualizado_en: timestamp (== request.time)
//
// Colección: catalogos/{catalogoId}   (catálogos configurables, ej. subgrupos)
//   - id: string (== ID del documento)
//   - nombre: string 1..120
//   - items: list (<= 100 elementos)
//   - actualizado_en: timestamp (== request.time)
//   - actualizado_por_uid: string (== request.auth.uid)
//
// Colección: incidencias_personal/{incidenciaId}   (bitácora inmutable de incidencias)
//   - id: string (== ID del documento, inmutable)
//   - usuario_uid: string 1..128
//   - usuario_nombre: string 1..200
//   - operativo_id: string 1..128 | null
//   - tipo: 'Falta' | 'Retardo' | 'Conducta' | 'Incumplimiento' |
//           'Reconocimiento' | 'Observación'
//   - gravedad: 'Baja' | 'Media' | 'Alta'
//   - descripcion: string 1..1000
//   - creado_por_uid: string (== request.auth.uid)
//   - creado_por_nombre: string 1..200
//   - creado_en: timestamp (== request.time)
//
// Colección: auditoria_eventos/{eventoId}   (bitácora inmutable)
//   - tipo: 'APROBACION_USUARIO' | 'RECHAZO_USUARIO' | 'BAJA_USUARIO' | 'CAMBIO_ROL' |
//           'CREACION_OPERATIVO' | 'CAMBIO_RECEPCION_OPERATIVO' |
//           'CAMBIO_CONVOCATORIA_OPERATIVO' | 'CAMBIO_MODO_QR' |
//           'ASIGNACION_EQUIPO' | 'DEVOLUCION_EQUIPO' | 'ACTA_INCIDENCIA' |
//           'SALIDA_MANUAL' | 'INTENTO_ACCESO_INACTIVO' |
//           'CREACION_CANAL_RADIO' | 'EDICION_BITACORA_RADIO' | 'SEED_CLAVES_REBACE' |
//           'EDICION_CATALOGO_CLAVES' | 'ACTUALIZACION_PERSONAL' | 'ASIGNACION_RADIO' |
//           'FINALIZACION_OPERATIVO' | 'ELIMINACION_OPERATIVO' |
//           'INCIDENCIA_PERSONAL' | 'EDICION_CATALOGO_SUBGRUPOS' | 'PROMOCION_LOTE' |
//           'CORRECCION_IDENTIDAD'
//   - actor_uid: string (== request.auth.uid)
//   - actor_nombre: string 1..200
//   - objetivo_uid: string 1..128
//   - objetivo_nombre: string 1..200
//   - detalle: string 0..500
//   - creado_en: timestamp (== request.time)
//   Campos opcionales (obligatorios con longitud 1..500 cuando tipo == 'CORRECCION_IDENTIDAD'):
//   - valor_anterior: string 0..500 | null
//   - valor_nuevo: string 0..500 | null
//
// Colección: fotos_perfiles/{uid}   (foto de perfil WebP en base64, sin Storage)
//   - uid: string (== ID del documento, inmutable)
//   - imagen_webp_base64: string 50..160000 (data:image/webp;base64,...)
//   - actualizado_en: timestamp (== request.time)
//
// Colección: operativos/{operativoId}
//   - id: string (== ID del documento, inmutable)
//   - nombre: string 1..120
//   - categoria: 'Operativos Masivos' | 'Proyectos y Soporte Técnico' |
//                'Guardias Ordinarias' | 'Capacitaciones, Simulacros y Difusión'
//   - sede: string 1..120
//   - fecha_inicio: string 10..20
//   - fecha_fin: string 0..20
//   - descripcion: string 0..500
//   - recepcion_abierta: bool
//   - modo_qr: 'estatico' | 'dinamico'
//   - qr_token_estatico: string 1..128
//   - estatus: 'Activo' | 'Finalizado' (opcional, por defecto 'Activo'; Finalizado es irreversible)
//   - convocatoria_abierta: bool (opcional, por defecto false)
//   - cupo_sugerido: int 1..1000 | null (opcional, por defecto null = sin límite)
//   - prerregistros_count: int >= 0 (opcional, 0 al crear; conteo sincronizado)
//   - creado_por_uid: string 1..128 (== request.auth.uid al crear, inmutable)
//   - creado_por_nombre: string 1..200 (inmutable)
//   - creado_en: timestamp (== request.time al crear, inmutable)
//   - actualizado_en: timestamp (== request.time en cada escritura)
//
// Subcolección: operativos/{operativoId}/secretos/totp
//   - secreto_base32: string 16..128 (Base32 ^[A-Z2-7]+$)
//   - periodo_segundos: int (== 30)
//   - digitos: int (== 6)
//   - actualizado_en: timestamp (== request.time)
//
// Subcolección: operativos/{operativoId}/prerregistros/{uid}   (ID = usuario_uid)
//   - usuario_uid: string (== ID del documento, inmutable)
//   - usuario_nombre: string 1..200
//   - usuario_cuenta: string 1..12
//   - etapa: 'Alfa' | 'Omega' | 'SIERRA' | 'Grupo Operativo'
//   - subgrupo: string 0..60
//   - ayudantia: 'Capacitación' | 'Administración de Personal' |
//                'Tesla' | 'Socorros' | 'Logística' | 'Ninguna'
//   - origen: 'Autoregistro' | 'Manual_Encargado'
//   - registrado_por_uid: string 1..128 (== request.auth.uid al crear, inmutable)
//   - fecha_registro: timestamp (== request.time al crear, inmutable)
//   Campos opcionales (en update se validan parcialmente los campos tocados para
//   compatibilidad con documentos históricos legacy con ayudantia o ayudantia_slot):
//   - ayudantia_slot: string (== ayudantia, inmutable)
//   - rol_en_turno: rol operativo válido (editable en convocatoria por Admin/Encargado)
//   - rol_editado_manual: bool (opcional)
//   - actualizado_en: timestamp (== request.time al crear/editar)
//
// Colección: asistencias_personal/{asistenciaId}
//   - id: string (== ID del documento, inmutable)
//   - operativo_id: string 1..128 (inmutable)
//   - operativo_nombre: string 1..120 (inmutable)
//   - usuario_uid: string 1..128 (inmutable)
//   - usuario_nombre: string 1..200 (inmutable)
//   - usuario_cuenta: string 1..12 (inmutable)
//   - grupo_operativo: 'Alfa' | 'Omega' | 'Ninguno' (inmutable)
//   - ayudantia_slot: 'Capacitación' | 'Administración de Personal' |
//                     'Tesla' | 'Socorros' | 'Logística' | 'Ninguna' (inmutable)
//   - rol_en_turno: 'Búsqueda y Rescate' | 'Radios' | 'Encargados' |
//                   'Abastecedores' | 'Atención' | 'Sin definir' (y legados)
//   - estado_operativo: 'En servicio' | 'En descanso' | 'Reserva' | 'Retirado'
//   - signos_vitales: map { spo2, fc, fr, ta, temp, tomado_en, tomado_por } | null
//   - metodo_entrada: 'QR_Operativo_TOTP' | 'QR_Operativo_Estatico' |
//                     'QR_Credencial' | 'Manual' (inmutable)
//   - hora_entrada: timestamp (== request.time al crear, inmutable)
//   - hora_salida: timestamp | null (sujeto a Candado Duro de Salida)
//   - horas_totales: number >= 0 | null
//   - salida_cerrada_manual: bool
//   - equipos_bupc_pendientes: int >= 0
//   - registrado_por_uid: string 1..128 (== request.auth.uid al crear, inmutable)
//   - creado_en: timestamp (== request.time al crear, inmutable)
//   - actualizado_en: timestamp (== request.time en cada escritura)
//
// Colección: equipos_turno/{equipoId}
//   - id: string (== ID del documento, inmutable)
//   - asistencia_id: string 1..128 (inmutable)
//   - operativo_id: string 1..128 (inmutable)
//   - usuario_uid: string 1..128 (inmutable)
//   - usuario_nombre: string 1..200 (inmutable)
//   - nombre_articulo: string 1..120 (inmutable)
//   - codigo_inventario: string 0..60 (inmutable)
//   - origen_material: 'BUPC_Asignado' | 'Propio' (inmutable)
//   - estado_reporte: 'OK' | 'Con_Falla' | 'Devuelto' | 'Incidencia'
//   - falla_reportada: string 0..400
//   - devuelto: bool
//   - devuelto_en: timestamp | null
//   - devuelto_por_uid: string 1..128 | null
//   - acta_incidencia: map { motivo, evidencia_id, registrado_por_uid,
//                            registrado_por_nombre, registrado_en } | null
//   - creado_por_uid: string 1..128 (== request.auth.uid al crear, inmutable)
//   - creado_en: timestamp (== request.time al crear, inmutable)
//   - actualizado_en: timestamp (== request.time en cada escritura)
//   Campos opcionales (retrocompatibles con v1.0, inmutables tras creación):
//   - creado_por_nombre: string 0..200 (opcional)
//   - operativo_nombre: string 0..120 (opcional)
//   - cantidad: int 1..99 (opcional, por defecto 1)
//   - ayudantia_slot: 'Capacitación' | 'Administración de Personal' |
//                     'Tesla' | 'Socorros' | 'Logística' | 'Ninguna' (opcional, inmutable)
//
// Colección: evidencias_equipos/{evidenciaId}   (evidencia fotográfica WebP inmutable)
//   - id: string (== ID del documento, inmutable)
//   - equipo_id: string 1..128 (inmutable)
//   - asistencia_id: string 1..128 (inmutable)
//   - operativo_id: string 1..128 (inmutable)
//   - imagen_webp_base64: string 50..160000 (data:image/webp;base64,...)
//   - creado_por_uid: string (== request.auth.uid, inmutable)
//   - creado_en: timestamp (== request.time, inmutable)
//
// Colección: canales_radio/{canalId}   (canales de radiocomunicación por operativo)
//   - id: string (== ID del documento, inmutable)
//   - operativo_id: string 1..128 (inmutable)
//   - nombre_canal: string 1..80 (inmutable)
//   - frecuencia_etiqueta: string 0..40
//   - unidades_participantes: list (<= 50 elementos)
//   - creado_por: string 1..200 (inmutable)
//   - creado_por_uid: string 1..128 (== request.auth.uid al crear, inmutable)
//   - creado_en: timestamp (== request.time al crear, inmutable)
//   - actualizado_en: timestamp (== request.time en cada escritura)
//
// Colección: bitacora_radio_registros/{registroId}   (bitácora de radio con hora_original inmutable)
//   - id: string (== ID del documento, inmutable)
//   - canal_id: string 1..128 (inmutable)
//   - operativo_id: string 1..128 (inmutable)
//   - hora_original: string 'HH:MM:SS' (8 caracteres, inmutable)
//   - origen: string 1..80 (inmutable)
//   - destinos: list (1..30 elementos, inmutable)
//   - actividades: string 1..1000
//   - registrado_por: string 1..200 (inmutable)
//   - registrado_por_uid: string 1..128 (== request.auth.uid al crear, inmutable)
//   - fue_editado: bool (false al crear, true al editar)
//   - actividad_original_respaldo: string 1..1000 | null (null al crear, obligatorio al editar)
//   - editado_en: timestamp | null (null al crear, == request.time al editar)
//   - editado_por: string 1..200 | null (null al crear, obligatorio al editar)
//   - creado_en: timestamp (== request.time al crear, inmutable)
//   - actualizado_en: timestamp (== request.time en cada escritura)
//
// Colección: catalogo_claves/{claveId}   (5 tablas del catálogo ReBaCE v2)
//   - id: string (== ID del documento)
//   - tabla: 'codigos_1_100' | 'claves_personales' | 'alfabeto_fonetico' |
//            'codigo_q' | 'morse_banderolas'
//   - codigo: string 1..30
//   - significado: string 1..250
//   - categoria: string 0..80
//   - es_basico: bool
//   - orden: int >= 0
//
// Los roles viven en el documento usuarios/{uid} (Plan Spark, sin custom claims).
// El primer Administrador debe asignarse manualmente desde la consola.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Funciones auxiliares generales
    // -------------------------------------------------------------

    // ¿Hay una sesión iniciada?
    function isSignedIn() {
      return request.auth != null;
    }

    // ¿El usuario autenticado es el dueño del documento {uid}?
    function esPropietario(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Perfil del usuario autenticado (una sola lectura get(), se reutiliza
    // en caché dentro de la misma solicitud). Si no existe, la regla falla => denegado.
    function perfilPropio() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Helpers retrocompatibles de jerarquía sobre un mapa de perfil de usuario
    function ayudantiaDe(p) {
      return p.get('ayudantia', p.get('ayudantia_slot', 'Ninguna'));
    }

    function subgrupoDe(p) {
      return p.get('subgrupo', '');
    }

    function etapaDe(p) {
      return p.get('etapa', p.get('grupo_operativo', 'Ninguno'));
    }

    function coincideGrupo(valor, grupos, vacio) {
      return valor is string && valor != '' && valor != vacio && valor in grupos;
    }

    // ¿El perfil objetivo pertenece a alguno de los grupos a cargo del actor?
    function perteneceAGruposACargo(actor, objetivo) {
      let grupos = actor.get('grupos_a_cargo', []);
      return grupos is list
          && grupos.size() > 0
          && (coincideGrupo(subgrupoDe(objetivo), grupos, 'Ninguno')
              || coincideGrupo(ayudantiaDe(objetivo), grupos, 'Ninguna')
              || coincideGrupo(etapaDe(objetivo), grupos, 'Ninguno'));
    }

    // -------------------------------------------------------------
    // Helpers de RBAC aditivo
    // -------------------------------------------------------------

    // ¿La cuenta del usuario autenticado está Activa?
    function esActivo() {
      return isSignedIn() && perfilPropio().estatus == 'Activo';
    }

    // ¿Es un Administrador con cuenta Activa?
    function esAdminActivo() {
      let p = perfilPropio();
      return isSignedIn() && p.estatus == 'Activo' && p.rol_sistema == 'Administrador';
    }

    // ¿Es un Encargado con cuenta Activa?
    function esEncargadoActivo() {
      let p = perfilPropio();
      return isSignedIn() && p.estatus == 'Activo' && p.rol_sistema == 'Encargado';
    }

    // ¿Es un Encargado o Administrador con cuenta Activa?
    function esEncargadoOAdminActivo() {
      let p = perfilPropio();
      return isSignedIn()
          && p.estatus == 'Activo'
          && p.rol_sistema in ['Encargado', 'Administrador'];
    }

    // ¿El perfil p (con ayudantía ya resuelta ay) actúa como Jefe de Ayudantía Activo?
    // Requiere simultáneamente: estatus Activo + rol Encargado (no Administrador)
    // + pertenecer a Grupo Operativo (o legado sin 'etapa' con grupo_operativo == 'Ninguno')
    // + ayudantía activa asignada (distinta de 'Ninguna').
    function esJefeAyudantiaConAy(p, ay) {
      return p.estatus == 'Activo'
          && p.rol_sistema == 'Encargado'
          && ('etapa' in p
              ? p.etapa == 'Grupo Operativo'
              : p.get('grupo_operativo', 'Ninguno') == 'Ninguno')
          && ay in ['Capacitación', 'Administración de Personal',
                    'Tesla', 'Socorros', 'Logística'];
    }

    // ¿El mapa de perfil p corresponde a un Jefe de Ayudantía Activo?
    function esJefeAyudantiaDePerfil(p) {
      return esJefeAyudantiaConAy(p, ayudantiaDe(p));
    }

    // ¿El mapa d pertenece a la ayudantía activa ay (distinta de 'Ninguna')?
    // Compatible tanto con getDoc sobre documentos legados sin campo 'ayudantia'
    // como con el analizador estático de consultas list usando
    // where('ayudantia', '==', ay) o where('ayudantia_slot', '==', ay).
    function perteneceAyudantiaLectura(d, ay) {
      return d.get('ayudantia', 'Ninguna') == ay
          || d.get('ayudantia_slot', 'Ninguna') == ay;
    }

    // ¿Puede operar el módulo de radiocomunicación?
    // Únicamente Administrador Activo hereda Radio por defecto;
    // Encargado y Brigadista requieren autorizado_radio == true.
    function puedeUsarRadio() {
      let p = perfilPropio();
      return isSignedIn()
          && p.estatus == 'Activo'
          && (p.rol_sistema == 'Administrador' || p.autorizado_radio == true);
    }

    // ¿Puede un tercero leer/listar el perfil de usuarios/{uid}?
    // Evalúa perfilPropio() y ayudantiaDe(p) una sola vez. Las ramas Jefe de
    // Ayudantía y Encargado Opción B son mutuamente excluyentes.
    function puedeLeerUsuarioPorTercero() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (esJefeAyudantiaConAy(p, ay)
                    ? perteneceAyudantiaLectura(resource.data, ay)
                    : (resource.data.rol_sistema == 'Brigadista'
                       && perteneceAGruposACargo(p, resource.data))))
          );
    }

    // Sub-regla de actualización para Encargado (Jefe de Ayudantía vs Opción B).
    // Se invoca solo cuando el actor es Encargado Activo editando a un tercero.
    function puedeActualizarComoEncargado(p, changed) {
      let ay = ayudantiaDe(p);
      let camposAdscripcion = ['etapa', 'subgrupo', 'ayudantia',
                               'grupo_operativo', 'ayudantia_slot',
                               'actualizado_en'];
      return esJefeAyudantiaConAy(p, ay)
          ? (ayudantiaDe(resource.data) == ay
             && ayudantiaDe(request.resource.data) == ay
             && request.resource.data.ayudantia_slot == ay
             && (
               (ay == 'Tesla'
                && resource.data.rol_sistema != 'Administrador'
                && changed.hasOnly(['clave_radio', 'clave_personal_radio',
                                    'autorizado_radio', 'actualizado_en']))
               || (resource.data.rol_sistema == 'Brigadista'
                   && (changed.hasOnly(camposAdscripcion)
                       || (ay == 'Administración de Personal'
                           && changed.hasOnly(['estatus', 'etapa', 'subgrupo',
                                               'ayudantia', 'grupo_operativo',
                                               'ayudantia_slot', 'qr_codigo_unico',
                                               'actualizado_en']))))
             ))
          : (resource.data.rol_sistema == 'Brigadista'
             && changed.hasOnly(camposAdscripcion)
             && perteneceAGruposACargo(p, resource.data));
    }

    // ¿Puede un tercero (Admin, Jefe de Ayudantía o Encargado Opción B)
    // actualizar usuarios/{uid}? Evalúa perfilPropio() una sola vez.
    function puedeActualizarUsuarioPorTercero(uid, changed) {
      let p = perfilPropio();
      return p.estatus == 'Activo'
          && (
            (p.rol_sistema == 'Administrador'
             && changed.hasOnly(camposEditablesPorAdmin()))
            || (p.rol_sistema == 'Encargado'
                && request.auth.uid != uid
                && puedeActualizarComoEncargado(p, changed))
          );
    }

    // Helpers para perfiles_operativos/{uid} (1 sola lectura de perfilPropio()).
    function puedeLeerPerfilOperativoPorTercero() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (!esJefeAyudantiaConAy(p, ay)
                    || perteneceAyudantiaLectura(resource.data, ay)))
          );
    }

    function puedeEscribirPerfilOperativo() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (esJefeAyudantiaConAy(p, ay)
                && ayudantiaDe(request.resource.data) == ay
                && (resource == null || ayudantiaDe(resource.data) == ay))
          );
    }

    // Valores iniciales sin privilegios para alta/recuperación/corrección propia en Pendiente
    function tieneValoresInicialesPerfilOperativo(d) {
      return d.estatus == 'Pendiente'
          && (!('etapa' in d) || d.etapa in ['Alfa', 'Ninguno'])
          && (!('subgrupo' in d) || d.subgrupo == '' || d.subgrupo == null)
          && (!('ayudantia' in d) || d.ayudantia == 'Ninguna')
          && (!('grupo_operativo' in d) || d.grupo_operativo == 'Ninguno')
          && (!('ayudantia_slot' in d) || d.ayudantia_slot == 'Ninguna')
          && (!('qr_codigo_unico' in d) || d.qr_codigo_unico == null)
          && (!('clave_radio' in d) || d.clave_radio == null || d.clave_radio == '');
    }

    // Escritura propia de perfiles_operativos/{uid} únicamente en alta inicial,
    // recuperación de cuenta huérfana o corrección mientras usuarios/{uid} esté Pendiente.
    function puedeEscribirPerfilOperativoPropioPendiente(uid) {
      let uPath = /databases/$(database)/documents/usuarios/$(uid);
      return esPropietario(uid)
          && tieneValoresInicialesPerfilOperativo(request.resource.data)
          && (!exists(uPath) || get(uPath).data.estatus == 'Pendiente')
          && existsAfter(uPath)
          && getAfter(uPath).data.estatus == 'Pendiente';
    }

    // Helpers para incidencias_personal/{incidenciaId}.
    function puedeLeerIncidenciaGet() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      let uPath = /databases/$(database)/documents/usuarios/$(resource.data.usuario_uid);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (resource.data.creado_por_uid == request.auth.uid
                    || (exists(uPath)
                        && (esJefeAyudantiaConAy(p, ay)
                            ? ayudantiaDe(get(uPath).data) == ay
                            : perteneceAGruposACargo(p, get(uPath).data)))))
          );
    }

    function puedeCrearIncidencia(d) {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      let uPath = /databases/$(database)/documents/usuarios/$(d.usuario_uid);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (esJefeAyudantiaConAy(p, ay)
                    ? (exists(uPath)
                       && get(uPath).data.rol_sistema == 'Brigadista'
                       && ayudantiaDe(get(uPath).data) == ay
                       && (d.operativo_id == null || operativoNoFinalizado(d.operativo_id)))
                    : ((d.operativo_id != null && operativoNoFinalizado(d.operativo_id))
                       || (exists(uPath)
                           && get(uPath).data.rol_sistema == 'Brigadista'
                           && perteneceAGruposACargo(p, get(uPath).data)))))
          );
    }

    // Actualización unificada de usuarios/{uid}: calcula camposCambiados() una
    // sola vez y evalúa de menor a mayor costo (adscripción -> autorización ->
    // esquema completo) para mantenerse muy por debajo del límite de 1000 expresiones.
    function puedeActualizarUsuario(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return adscripcionGrupoOperativoValida(d, changed)
          && (
            (request.auth.uid == uid
             && (
               (resource.data.estatus == 'Pendiente'
                && d.estatus == 'Pendiente'
                && changed.hasOnly(camposEditablesPorDuenoPendiente()))
               || (resource.data.estatus == 'Activo'
                   && d.estatus == 'Activo'
                   && changed.hasOnly(camposEditablesPorDuenoActivo()))
             ))
            || puedeActualizarUsuarioPorTercero(uid, changed)
          )
          && esUsuarioValido(d, uid);
    }

    // -------------------------------------------------------------
    // Helpers de estado del operativo padre
    // -------------------------------------------------------------

    // ¿Existe el operativo y NO ha sido Finalizado? (retrocompatible sin campo estatus)
    function operativoNoFinalizado(opId) {
      return exists(/databases/$(database)/documents/operativos/$(opId))
          && get(/databases/$(database)/documents/operativos/$(opId)).data.get('estatus', 'Activo') != 'Finalizado';
    }

    // ¿El operativo no está Finalizado y mantiene recepción abierta?
    function operativoConRecepcionAbierta(opId) {
      return operativoNoFinalizado(opId)
          && get(/databases/$(database)/documents/operativos/$(opId)).data.recepcion_abierta == true;
    }

    // Actualización atómica del contador prerregistros_count por un brigadista Activo
    // dentro de una transacción con su propio documento prerregistros/{request.auth.uid}.
    function actualizacionContadorPrerregistroPropia(operativoId, changed) {
      let prev = resource.data.get('prerregistros_count', 0);
      let next = request.resource.data.get('prerregistros_count', -1);
      let cupo = resource.data.get('cupo_sugerido', null);
      let prePath = /databases/$(database)/documents/operativos/$(operativoId)/prerregistros/$(request.auth.uid);
      return resource.data.get('convocatoria_abierta', false) == true
          && changed.hasOnly(['prerregistros_count', 'actualizado_en'])
          && next is int
          && next >= 0
          && (
            (next == prev + 1
             && (cupo == null || next <= cupo)
             && !exists(prePath)
             && existsAfter(prePath))
            || (next == prev - 1
                && exists(prePath)
                && !existsAfter(prePath))
          );
    }

    // Actualización unificada de operativos/{operativoId}: lee perfilPropio() y
    // camposCambiados() una sola vez (cortocircuito rápido para Encargado/Admin).
    function puedeActualizarOperativo(operativoId) {
      let p = perfilPropio();
      let changed = camposCambiados();
      return p.estatus == 'Activo'
          && (
            (p.rol_sistema in ['Encargado', 'Administrador']
             && !changed.hasAny(['id', 'creado_por_uid', 'creado_por_nombre', 'creado_en']))
            || actualizacionContadorPrerregistroPropia(operativoId, changed)
          )
          && esOperativoValido(request.resource.data, operativoId);
    }

    // -------------------------------------------------------------
    // Helpers de catálogo de roles operativos
    // -------------------------------------------------------------

    // ¿El rol operativo en turno pertenece al catálogo oficial o valores legados?
    function esRolEnTurnoValido(rol) {
      return rol in ['Búsqueda y Rescate', 'Radios', 'Encargados',
                     'Abastecedores', 'Atención', 'Sin definir',
                     'Primeros Auxilios', 'Radiocomunicación',
                     'Evacuación', 'Logística', 'Encargado', 'Sin asignar'];
    }

    // Rol operativo predeterminado según la ayudantía del brigadista.
    function rolOperativoPorAyudantia(ay) {
      return ay == 'Capacitación' ? 'Búsqueda y Rescate'
          : ay == 'Tesla' ? 'Radios'
          : ay == 'Administración de Personal' ? 'Encargados'
          : ay == 'Logística' ? 'Abastecedores'
          : ay == 'Socorros' ? 'Atención'
          : 'Sin definir';
    }

    // ¿Puede un Encargado/Admin leer o listar operativos/{operativoId}/prerregistros/{uid}?
    function puedeLeerPrerregistroComoEncargadoOAdmin() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (!esJefeAyudantiaConAy(p, ay)
                    || resource.data.ayudantia == ay
                    || resource.data.get('ayudantia_slot', 'Ninguna') == ay))
          );
    }

    // Sub-helper para crear prerregistro usando el mapa ya leído del operativo padre.
    function puedeCrearPrerregistroEnOperativo(op, uid) {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      let esJefe = esJefeAyudantiaConAy(p, ay);
      return op.get('estatus', 'Activo') != 'Finalizado'
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (esJefe
                && request.resource.data.ayudantia == ay
                && (!('ayudantia_slot' in request.resource.data)
                    || request.resource.data.ayudantia_slot == ay))
            || (p.rol_sistema == 'Encargado' && !esJefe)
            || (request.auth.uid == uid
                && p.rol_sistema == 'Brigadista'
                && request.resource.data.origen == 'Autoregistro'
                && op.get('convocatoria_abierta', false) == true
                && request.resource.data.ayudantia == ay
                && (!('rol_en_turno' in request.resource.data)
                    || request.resource.data.rol_en_turno == rolOperativoPorAyudantia(ay))
                && (!('rol_editado_manual' in request.resource.data)
                    || request.resource.data.rol_editado_manual == false))
          );
    }

    // ¿Puede crear operativos/{operativoId}/prerregistros/{uid}? (1 solo get() al padre).
    function puedeCrearPrerregistro(operativoId, uid) {
      let opPath = /databases/$(database)/documents/operativos/$(operativoId);
      return exists(opPath)
          && puedeCrearPrerregistroEnOperativo(get(opPath).data, uid);
    }

    // ¿Puede un Encargado/Admin actualizar rol_en_turno en prerregistros/{uid}?
    function puedeActualizarPrerregistroComoEncargadoOAdmin() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (!esJefeAyudantiaConAy(p, ay)
                    || perteneceAyudantiaLectura(resource.data, ay)))
          );
    }

    // Sub-helper para eliminar prerregistro usando el mapa ya leído del operativo padre.
    function puedeEliminarPrerregistroEnOperativo(op, uid) {
      let p = perfilPropio();
      let esJefe = esJefeAyudantiaDePerfil(p);
      return op.get('estatus', 'Activo') != 'Finalizado'
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (esJefe && resource.data.ayudantia == ayudantiaDe(p))
            || (p.rol_sistema == 'Encargado' && !esJefe)
            || (request.auth.uid == uid
                && op.get('convocatoria_abierta', false) == true)
          );
    }

    // ¿Puede eliminar operativos/{operativoId}/prerregistros/{uid}? (1 solo get() al padre).
    function puedeEliminarPrerregistro(operativoId, uid) {
      let opPath = /databases/$(database)/documents/operativos/$(operativoId);
      return exists(opPath)
          && puedeEliminarPrerregistroEnOperativo(get(opPath).data, uid);
    }

    // Helpers para asistencias_personal/{asistenciaId} y equipos_turno/{equipoId}.
    function puedeLeerAsistencia() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || resource.data.usuario_uid == request.auth.uid
            || (p.rol_sistema == 'Encargado'
                && (!esJefeAyudantiaConAy(p, ay)
                    || resource.data.ayudantia_slot == ay))
          );
    }

    // Valida el rol_en_turno en auto-registro QR propio: respeta el rol asignado
    // en prerregistros/{uid} si existe y contiene rol_en_turno; en caso contrario
    // exige el rol operativo predeterminado según la ayudantía del perfil.
    function rolAutoRegistroAsistenciaValido(opId, rol, ay) {
      let prePath = /databases/$(database)/documents/operativos/$(opId)/prerregistros/$(request.auth.uid);
      return (exists(prePath) && 'rol_en_turno' in get(prePath).data)
          ? rol == get(prePath).data.rol_en_turno
          : rol == rolOperativoPorAyudantia(ay);
    }

    function puedeCrearAsistenciaPorRol() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (!esJefeAyudantiaConAy(p, ay)
                    || request.resource.data.ayudantia_slot == ay))
            || (request.resource.data.usuario_uid == request.auth.uid
                && request.resource.data.ayudantia_slot == ay
                && rolAutoRegistroAsistenciaValido(request.resource.data.operativo_id,
                                                   request.resource.data.rol_en_turno,
                                                   ay)
                && request.resource.data.estado_operativo == 'En servicio'
                && request.resource.data.salida_cerrada_manual == false
                && request.resource.data.signos_vitales == null
                && request.resource.data.metodo_entrada in ['QR_Operativo_TOTP',
                                                            'QR_Operativo_Estatico'])
          );
    }

    function puedeActualizarAsistenciaPorRol() {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      let changed = camposCambiados();
      return p.estatus == 'Activo'
          && (
            (resource.data.usuario_uid == request.auth.uid
             && resource.data.hora_salida == null
             && resource.data.equipos_bupc_pendientes == 0
             && changed.hasOnly(['hora_salida', 'horas_totales',
                                 'estado_operativo', 'actualizado_en'])
             && request.resource.data.hora_salida == request.time
             && request.resource.data.estado_operativo == 'Retirado')
            || ((p.rol_sistema == 'Administrador'
                 || (p.rol_sistema == 'Encargado'
                     && (!esJefeAyudantiaConAy(p, ay)
                         || resource.data.ayudantia_slot == ay)))
                && changed.hasOnly(['rol_en_turno', 'estado_operativo',
                                    'signos_vitales', 'equipos_bupc_pendientes',
                                    'hora_salida', 'horas_totales',
                                    'salida_cerrada_manual', 'actualizado_en'])
                && candadoDuroRespetado())
          );
    }

    function puedeGestionarEquipoComoEncargadoOAdmin(asistenciaId) {
      let p = perfilPropio();
      let ay = ayudantiaDe(p);
      let asisPath = /databases/$(database)/documents/asistencias_personal/$(asistenciaId);
      return isSignedIn()
          && p.estatus == 'Activo'
          && (
            p.rol_sistema == 'Administrador'
            || (p.rol_sistema == 'Encargado'
                && (!esJefeAyudantiaConAy(p, ay)
                    || (exists(asisPath)
                        && get(asisPath).data.ayudantia_slot == ay)))
          );
    }

    // -------------------------------------------------------------
    // Utilidades de validación
    // -------------------------------------------------------------

    // Campos modificados en una actualización
    function camposCambiados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Cadena con longitud dentro de [min, max]
    function cadena(valor, min, max) {
      return valor is string && valor.size() >= min && valor.size() <= max;
    }

    // Cadena con longitud máxima [0, max]
    function cadenaMax(valor, max) {
      return valor is string && valor.size() <= max;
    }

    // Cadena con longitud dentro de [min, max] o null
    function cadenaONull(valor, min, max) {
      return valor == null || cadena(valor, min, max);
    }

    // -------------------------------------------------------------
    // Listas de campos de usuarios
    // -------------------------------------------------------------

    // 28 campos obligatorios base (retrocompatibilidad total con v1.0)
    function camposUsuarioBase() {
      return ['uid', 'correo', 'nombres', 'apellido_paterno', 'apellido_materno',
              'fecha_nacimiento', 'sexo', 'telefono_fijo', 'celular',
              'celular_con_whatsapp', 'nivel_academico', 'escuela_carrera',
              'numero_cuenta', 'tipo_sangre', 'alergias',
              'padecimientos_medicamentos', 'contacto_emergencia_nombre',
              'contacto_emergencia_telefono', 'grupo_operativo', 'ayudantia_slot',
              'rol_sistema', 'autorizado_radio', 'clave_personal_radio', 'estatus',
              'qr_codigo_unico', 'tiene_foto', 'creado_en', 'actualizado_en'];
    }

    // Campos opcionales v1.1 (jerarquía escalable, radio y contacto de emergencia)
    function camposUsuarioOpcionales() {
      return ['etapa', 'subgrupo', 'ayudantia', 'grupos_a_cargo', 'clave_radio',
              'contacto_emergencia_parentesco'];
    }

    // Campos que el dueño en estatus 'Pendiente' puede corregir antes de su aprobación
    function camposEditablesPorDuenoPendiente() {
      return ['nombres', 'apellido_paterno', 'apellido_materno', 'fecha_nacimiento',
              'sexo', 'telefono_fijo', 'celular', 'celular_con_whatsapp',
              'nivel_academico', 'escuela_carrera', 'numero_cuenta', 'tipo_sangre',
              'alergias', 'padecimientos_medicamentos', 'contacto_emergencia_nombre',
              'contacto_emergencia_parentesco', 'contacto_emergencia_telefono',
              'actualizado_en'];
    }

    // Campos operativos/médicos no identitarios que el dueño 'Activo' puede modificar
    function camposEditablesPorDuenoActivo() {
      return ['telefono_fijo', 'celular', 'celular_con_whatsapp', 'tipo_sangre',
              'alergias', 'padecimientos_medicamentos', 'contacto_emergencia_nombre',
              'contacto_emergencia_parentesco', 'contacto_emergencia_telefono',
              'tiene_foto', 'actualizado_en'];
    }

    // Campos que un Administrador Activo puede modificar (incluye corrección de identidad)
    function camposEditablesPorAdmin() {
      return ['nombres', 'apellido_paterno', 'apellido_materno', 'numero_cuenta',
              'grupo_operativo', 'ayudantia_slot', 'etapa', 'subgrupo', 'ayudantia',
              'grupos_a_cargo', 'rol_sistema', 'autorizado_radio',
              'clave_personal_radio', 'clave_radio', 'estatus',
              'qr_codigo_unico', 'actualizado_en'];
    }

    // -------------------------------------------------------------
    // Validador de dominio: usuarios (se usa en create Y en update)
    // -------------------------------------------------------------
    function esUsuarioValido(d, uid) {
      let base = camposUsuarioBase();
      let keys = d.keys();
      let ayudantias = ['Capacitación', 'Administración de Personal', 'Tesla',
                        'Socorros', 'Logística', 'Ninguna'];
      return keys.hasAll(base)
          && keys.hasOnly(base.concat(camposUsuarioOpcionales()))
          && d.uid == uid
          && cadena(d.correo, 3, 254)
          && cadena(d.nombres, 1, 80)
          && cadena(d.apellido_paterno, 1, 60)
          && cadenaMax(d.apellido_materno, 60)
          && d.fecha_nacimiento is string
          && d.fecha_nacimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.sexo in ['Mujer', 'Hombre', 'Prefiero no decir']
          && cadenaMax(d.telefono_fijo, 20)
          && cadena(d.celular, 1, 20)
          && d.celular_con_whatsapp is bool
          && d.nivel_academico in ['Media Superior', 'Superior', 'Egresado',
                                   'Estudiante externo UdeC']
          && cadena(d.escuela_carrera, 1, 120)
          && cadena(d.numero_cuenta, 1, 12)
          && d.tipo_sangre in ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-']
          && cadenaMax(d.alergias, 300)
          && cadenaMax(d.padecimientos_medicamentos, 500)
          && cadena(d.contacto_emergencia_nombre, 1, 120)
          && cadena(d.contacto_emergencia_telefono, 1, 20)
          && d.grupo_operativo in ['Alfa', 'Omega', 'Ninguno']
          && d.ayudantia_slot in ayudantias
          && d.rol_sistema in ['Brigadista', 'Encargado', 'Administrador']
          && d.autorizado_radio is bool
          && cadenaONull(d.clave_personal_radio, 1, 10)
          && d.estatus in ['Pendiente', 'Activo', 'Inactivo']
          && cadenaONull(d.qr_codigo_unico, 1, 64)
          && d.tiene_foto is bool
          && d.creado_en is timestamp
          && d.actualizado_en is timestamp
          && (!('etapa' in d) || d.etapa in ['Alfa', 'Omega', 'SIERRA', 'Grupo Operativo'])
          && (!('subgrupo' in d) || cadenaMax(d.subgrupo, 60))
          && (!('ayudantia' in d) || d.ayudantia in ayudantias)
          && (!('grupos_a_cargo' in d)
              || (d.grupos_a_cargo is list && d.grupos_a_cargo.size() <= 30))
          && (!('clave_radio' in d) || d.clave_radio == null || cadenaMax(d.clave_radio, 20))
          && (!('contacto_emergencia_parentesco' in d)
              || cadenaMax(d.contacto_emergencia_parentesco, 60));
    }

    // Valores iniciales obligatorios al registrarse (anti-escalamiento)
    function tieneValoresIniciales(d) {
      return d.correo == request.auth.token.email
          && d.estatus == 'Pendiente'
          && d.rol_sistema == 'Brigadista'
          && d.autorizado_radio == false
          && d.grupo_operativo == 'Ninguno'
          && d.ayudantia_slot == 'Ninguna'
          && d.clave_personal_radio == null
          && d.qr_codigo_unico == null
          && d.tiene_foto == false
          && d.creado_en == request.time
          && d.actualizado_en == request.time
          && (!('grupos_a_cargo' in d) || d.grupos_a_cargo.size() == 0)
          && (!('ayudantia' in d) || d.ayudantia == 'Ninguna')
          && (!('clave_radio' in d) || d.clave_radio == null || d.clave_radio == '')
          && (!('subgrupo' in d) || d.subgrupo == '' || d.subgrupo == 'Ninguno');
    }

    function tieneAyudantiaGrupoOperativo(d, changed) {
      let ay = d.get('ayudantia', 'Ninguna');
      let slot = d.get('ayudantia_slot', 'Ninguna');
      return d.get('subgrupo', '') == ''
          && (ay != 'Ninguna' || slot != 'Ninguna')
          && (!('ayudantia' in changed) || ay != 'Ninguna')
          && (!('ayudantia_slot' in changed) || slot != 'Ninguna');
    }

    // Regla BUPC: al asignar o modificar adscripción a 'Grupo Operativo', es obligatorio
    // contar con una ayudantía válida (distinta de 'Ninguna') y no tener subgrupo formativo.
    // Solo se evalúa cuando se modifican campos de adscripción para no bloquear cuentas
    // legadas que leen su perfil o actualizan su Ficha de Emergencia / datos personales.
    function adscripcionGrupoOperativoValida(d, changed) {
      return !changed.hasAny(['etapa', 'ayudantia', 'ayudantia_slot', 'grupo_operativo', 'subgrupo'])
          || d.get('etapa', '') != 'Grupo Operativo'
          || tieneAyudantiaGrupoOperativo(d, changed);
    }

    // -------------------------------------------------------------
    // Validador de dominio: perfiles_operativos (create Y update)
    // -------------------------------------------------------------
    function esPerfilOperativoValido(d, uid) {
      let camposPermitidos = ['uid', 'nombre_completo', 'numero_cuenta', 'estatus',
                              'etapa', 'subgrupo', 'ayudantia', 'grupo_operativo',
                              'ayudantia_slot', 'qr_codigo_unico', 'clave_radio',
                              'actualizado_en'];
      return d.keys().hasAll(['uid', 'nombre_completo', 'estatus', 'actualizado_en'])
          && d.keys().hasOnly(camposPermitidos)
          && d.uid == uid
          && cadena(d.nombre_completo, 1, 200)
          && (!('numero_cuenta' in d) || cadena(d.numero_cuenta, 1, 12))
          && d.estatus in ['Pendiente', 'Activo', 'Inactivo']
          && (!('etapa' in d) || d.etapa in ['Alfa', 'Omega', 'SIERRA', 'Grupo Operativo', 'Ninguno'])
          && (!('subgrupo' in d) || cadenaONull(d.subgrupo, 0, 60))
          && (!('ayudantia' in d)
              || d.ayudantia in ['Capacitación', 'Administración de Personal',
                                 'Tesla', 'Socorros', 'Logística', 'Ninguna'])
          && (!('grupo_operativo' in d) || d.grupo_operativo in ['Alfa', 'Omega', 'Ninguno'])
          && (!('ayudantia_slot' in d)
              || d.ayudantia_slot in ['Capacitación', 'Administración de Personal',
                                      'Tesla', 'Socorros', 'Logística', 'Ninguna'])
          && (!('qr_codigo_unico' in d) || cadenaONull(d.qr_codigo_unico, 1, 64))
          && (!('clave_radio' in d) || cadenaONull(d.clave_radio, 0, 20))
          && d.actualizado_en == request.time;
    }

    // -------------------------------------------------------------
    // Validador de dominio: catalogos (create Y update)
    // -------------------------------------------------------------
    function esCatalogoValido(d, catalogoId) {
      let campos = ['id', 'nombre', 'items', 'actualizado_en', 'actualizado_por_uid'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == catalogoId
          && cadena(d.nombre, 1, 120)
          && d.items is list
          && d.items.size() <= 100
          && d.actualizado_en == request.time
          && d.actualizado_por_uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Validador de dominio: incidencias_personal (solo create)
    // -------------------------------------------------------------
    function esIncidenciaPersonalValida(d, incidenciaId) {
      let campos = ['id', 'usuario_uid', 'usuario_nombre', 'operativo_id',
                    'tipo', 'gravedad', 'descripcion', 'creado_por_uid',
                    'creado_por_nombre', 'creado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == incidenciaId
          && cadena(d.usuario_uid, 1, 128)
          && cadena(d.usuario_nombre, 1, 200)
          && cadenaONull(d.operativo_id, 1, 128)
          && d.tipo in ['Falta', 'Retardo', 'Conducta', 'Incumplimiento',
                        'Reconocimiento', 'Observación']
          && d.gravedad in ['Baja', 'Media', 'Alta']
          && cadena(d.descripcion, 1, 1000)
          && d.creado_por_uid == request.auth.uid
          && cadena(d.creado_por_nombre, 1, 200)
          && d.creado_en == request.time;
    }

    // -------------------------------------------------------------
    // Validador de dominio: auditoria_eventos
    // -------------------------------------------------------------
    function esEventoValido(d) {
      let camposBase = ['tipo', 'actor_uid', 'actor_nombre', 'objetivo_uid',
                        'objetivo_nombre', 'detalle', 'creado_en'];
      let keys = d.keys();
      return keys.hasAll(camposBase)
          && keys.hasOnly(camposBase.concat(['valor_anterior', 'valor_nuevo']))
          && d.tipo in ['APROBACION_USUARIO', 'RECHAZO_USUARIO', 'BAJA_USUARIO',
                        'CAMBIO_ROL', 'CREACION_OPERATIVO',
                        'CAMBIO_RECEPCION_OPERATIVO',
                        'CAMBIO_CONVOCATORIA_OPERATIVO', 'CAMBIO_MODO_QR',
                        'ASIGNACION_EQUIPO', 'DEVOLUCION_EQUIPO', 'ACTA_INCIDENCIA',
                        'SALIDA_MANUAL', 'INTENTO_ACCESO_INACTIVO',
                        'CREACION_CANAL_RADIO', 'EDICION_BITACORA_RADIO',
                        'SEED_CLAVES_REBACE', 'EDICION_CATALOGO_CLAVES',
                        'ACTUALIZACION_PERSONAL', 'ASIGNACION_RADIO',
                        'FINALIZACION_OPERATIVO', 'ELIMINACION_OPERATIVO',
                        'INCIDENCIA_PERSONAL', 'EDICION_CATALOGO_SUBGRUPOS',
                        'PROMOCION_LOTE', 'CORRECCION_IDENTIDAD']
          && d.actor_uid == request.auth.uid
          && cadena(d.actor_nombre, 1, 200)
          && cadena(d.objetivo_uid, 1, 128)
          && cadena(d.objetivo_nombre, 1, 200)
          && cadena(d.detalle, 0, 500)
          && d.creado_en == request.time
          && (!('valor_anterior' in d) || cadenaONull(d.valor_anterior, 0, 500))
          && (!('valor_nuevo' in d) || cadenaONull(d.valor_nuevo, 0, 500))
          && (d.tipo != 'CORRECCION_IDENTIDAD'
              || ('valor_anterior' in d
                  && 'valor_nuevo' in d
                  && cadena(d.valor_anterior, 1, 500)
                  && cadena(d.valor_nuevo, 1, 500)));
    }

    // -------------------------------------------------------------
    // Validador de dominio: fotos_perfiles (se usa en create Y update)
    // -------------------------------------------------------------
    function esFotoPerfilValida(d, uid) {
      let campos = ['uid', 'imagen_webp_base64', 'actualizado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.uid == uid
          && d.imagen_webp_base64 is string
          && d.imagen_webp_base64.size() >= 50
          && d.imagen_webp_base64.size() <= 160000
          && d.imagen_webp_base64.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')
          && d.actualizado_en == request.time;
    }

    // -------------------------------------------------------------
    // Validador de dominio: operativos (se usa en create Y update)
    // -------------------------------------------------------------
    function esOperativoValido(d, operativoId) {
      let camposBase = ['id', 'nombre', 'categoria', 'sede', 'fecha_inicio',
                        'fecha_fin', 'descripcion', 'recepcion_abierta', 'modo_qr',
                        'qr_token_estatico', 'creado_por_uid', 'creado_por_nombre',
                        'creado_en', 'actualizado_en'];
      let keys = d.keys();
      return keys.hasAll(camposBase)
          && keys.hasOnly(camposBase.concat(['estatus', 'convocatoria_abierta',
                                             'cupo_sugerido', 'prerregistros_count']))
          && d.id == operativoId
          && cadena(d.nombre, 1, 120)
          && d.categoria in ['Operativos Masivos', 'Proyectos y Soporte Técnico',
                             'Guardias Ordinarias',
                             'Capacitaciones, Simulacros y Difusión']
          && cadena(d.sede, 1, 120)
          && cadena(d.fecha_inicio, 10, 20)
          && cadena(d.fecha_fin, 0, 20)
          && cadena(d.descripcion, 0, 500)
          && d.recepcion_abierta is bool
          && d.modo_qr in ['estatico', 'dinamico']
          && cadena(d.qr_token_estatico, 1, 128)
          && (!('estatus' in d) || d.estatus in ['Activo', 'Finalizado'])
          && (!('convocatoria_abierta' in d) || d.convocatoria_abierta is bool)
          && (!('cupo_sugerido' in d)
              || d.cupo_sugerido == null
              || (d.cupo_sugerido is int && d.cupo_sugerido >= 1 && d.cupo_sugerido <= 1000))
          && (!('prerregistros_count' in d)
              || (d.prerregistros_count is int && d.prerregistros_count >= 0))
          && cadena(d.creado_por_uid, 1, 128)
          && cadena(d.creado_por_nombre, 1, 200)
          && d.creado_en is timestamp
          && d.actualizado_en is timestamp;
    }

    // -------------------------------------------------------------
    // Validador de dominio: operativos/{operativoId}/secretos/totp
    // -------------------------------------------------------------
    function esSecretoTotpValido(d) {
      let campos = ['secreto_base32', 'periodo_segundos', 'digitos', 'actualizado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.secreto_base32 is string
          && d.secreto_base32.size() >= 16
          && d.secreto_base32.size() <= 128
          && d.secreto_base32.matches('^[A-Z2-7]+$')
          && d.periodo_segundos is int
          && d.periodo_segundos == 30
          && d.digitos is int
          && d.digitos == 6
          && d.actualizado_en == request.time;
    }

    // -------------------------------------------------------------
    // Validador de dominio: operativos/{operativoId}/prerregistros/{uid}
    // -------------------------------------------------------------
    function esPrerregistroValido(d, uid) {
      let camposBase = ['usuario_uid', 'usuario_nombre', 'usuario_cuenta', 'etapa',
                        'subgrupo', 'ayudantia', 'origen', 'registrado_por_uid',
                        'fecha_registro'];
      let keys = d.keys();
      return keys.hasAll(camposBase)
          && keys.hasOnly(camposBase.concat(['ayudantia_slot', 'rol_en_turno',
                                             'rol_editado_manual', 'actualizado_en']))
          && d.usuario_uid == uid
          && cadena(d.usuario_nombre, 1, 200)
          && cadena(d.usuario_cuenta, 1, 12)
          && d.etapa in ['Alfa', 'Omega', 'SIERRA', 'Grupo Operativo']
          && cadenaMax(d.subgrupo, 60)
          && d.ayudantia in ['Capacitación', 'Administración de Personal',
                             'Tesla', 'Socorros', 'Logística', 'Ninguna']
          && d.origen in ['Autoregistro', 'Manual_Encargado']
          && cadena(d.registrado_por_uid, 1, 128)
          && d.fecha_registro is timestamp
          && (!('ayudantia_slot' in d) || d.ayudantia_slot == d.ayudantia)
          && (!('rol_en_turno' in d) || esRolEnTurnoValido(d.rol_en_turno))
          && (!('rol_editado_manual' in d) || d.rol_editado_manual is bool)
          && (!('actualizado_en' in d) || d.actualizado_en is timestamp);
    }

    // -------------------------------------------------------------
    // Validador auxiliar: signos_vitales (mapa o null)
    // -------------------------------------------------------------
    function esSignosVitalesValidos(sv) {
      let campos = ['spo2', 'fc', 'fr', 'ta', 'temp', 'tomado_en', 'tomado_por'];
      return sv == null
          || (sv is map
              && sv.keys().hasAll(campos)
              && sv.keys().hasOnly(campos)
              && (sv.spo2 == null || sv.spo2 is number || cadena(sv.spo2, 0, 20))
              && (sv.fc == null || sv.fc is number || cadena(sv.fc, 0, 20))
              && (sv.fr == null || sv.fr is number || cadena(sv.fr, 0, 20))
              && (sv.ta == null || sv.ta is number || cadena(sv.ta, 0, 20))
              && (sv.temp == null || sv.temp is number || cadena(sv.temp, 0, 20))
              && (sv.tomado_en == null || sv.tomado_en is timestamp || cadena(sv.tomado_en, 0, 40))
              && cadenaONull(sv.tomado_por, 0, 200));
    }

    // -------------------------------------------------------------
    // Validador de dominio: asistencias_personal (create Y update)
    // -------------------------------------------------------------
    function esAsistenciaValida(d, asistenciaId) {
      let campos = ['id', 'operativo_id', 'operativo_nombre', 'usuario_uid',
                    'usuario_nombre', 'usuario_cuenta', 'grupo_operativo',
                    'ayudantia_slot', 'rol_en_turno', 'estado_operativo',
                    'signos_vitales', 'metodo_entrada', 'hora_entrada',
                    'hora_salida', 'horas_totales', 'salida_cerrada_manual',
                    'equipos_bupc_pendientes', 'registrado_por_uid',
                    'creado_en', 'actualizado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == asistenciaId
          && cadena(d.operativo_id, 1, 128)
          && cadena(d.operativo_nombre, 1, 120)
          && cadena(d.usuario_uid, 1, 128)
          && cadena(d.usuario_nombre, 1, 200)
          && cadena(d.usuario_cuenta, 1, 12)
          && d.grupo_operativo in ['Alfa', 'Omega', 'Ninguno']
          && d.ayudantia_slot in ['Capacitación', 'Administración de Personal',
                                  'Tesla', 'Socorros', 'Logística', 'Ninguna']
          && esRolEnTurnoValido(d.rol_en_turno)
          && d.estado_operativo in ['En servicio', 'En descanso', 'Reserva', 'Retirado']
          && esSignosVitalesValidos(d.signos_vitales)
          && d.metodo_entrada in ['QR_Operativo_TOTP', 'QR_Operativo_Estatico',
                                  'QR_Credencial', 'Manual']
          && d.hora_entrada is timestamp
          && (d.hora_salida == null || d.hora_salida is timestamp)
          && (d.horas_totales == null || (d.horas_totales is number && d.horas_totales >= 0))
          && d.salida_cerrada_manual is bool
          && d.equipos_bupc_pendientes is int
          && d.equipos_bupc_pendientes >= 0
          && cadena(d.registrado_por_uid, 1, 128)
          && d.creado_en is timestamp
          && d.actualizado_en is timestamp;
    }

    // Candado Duro de Salida (servidor): nadie puede registrar o modificar
    // hora_salida mientras existan equipos BUPC pendientes de devolución.
    function candadoDuroRespetado() {
      return request.resource.data.hora_salida == resource.data.hora_salida
          || (resource.data.equipos_bupc_pendientes == 0
              && request.resource.data.equipos_bupc_pendientes == 0);
    }

    // -------------------------------------------------------------
    // Validador auxiliar: acta_incidencia (mapa o null)
    // -------------------------------------------------------------
    function esActaIncidenciaValida(a) {
      let campos = ['motivo', 'evidencia_id', 'registrado_por_uid',
                    'registrado_por_nombre', 'registrado_en'];
      return a == null
          || (a is map
              && a.keys().hasAll(campos)
              && a.keys().hasOnly(campos)
              && cadena(a.motivo, 1, 400)
              && cadenaONull(a.evidencia_id, 0, 128)
              && cadena(a.registrado_por_uid, 1, 128)
              && cadena(a.registrado_por_nombre, 1, 200)
              && (a.registrado_en is timestamp || cadena(a.registrado_en, 1, 40)));
    }

    // -------------------------------------------------------------
    // Validador de dominio: equipos_turno (create Y update)
    // -------------------------------------------------------------
    function esEquipoTurnoValido(d, equipoId) {
      let camposBase = ['id', 'asistencia_id', 'operativo_id', 'usuario_uid',
                        'usuario_nombre', 'nombre_articulo', 'codigo_inventario',
                        'origen_material', 'estado_reporte', 'falla_reportada',
                        'devuelto', 'devuelto_en', 'devuelto_por_uid',
                        'acta_incidencia', 'creado_por_uid', 'creado_en',
                        'actualizado_en'];
      return d.keys().hasAll(camposBase)
          && d.keys().hasOnly(camposBase.concat(['creado_por_nombre',
                                                 'operativo_nombre',
                                                 'cantidad',
                                                 'ayudantia_slot']))
          && d.id == equipoId
          && cadena(d.asistencia_id, 1, 128)
          && cadena(d.operativo_id, 1, 128)
          && cadena(d.usuario_uid, 1, 128)
          && cadena(d.usuario_nombre, 1, 200)
          && cadena(d.nombre_articulo, 1, 120)
          && cadena(d.codigo_inventario, 0, 60)
          && d.origen_material in ['BUPC_Asignado', 'Propio']
          && d.estado_reporte in ['OK', 'Con_Falla', 'Devuelto', 'Incidencia']
          && cadena(d.falla_reportada, 0, 400)
          && d.devuelto is bool
          && (d.devuelto_en == null || d.devuelto_en is timestamp)
          && cadenaONull(d.devuelto_por_uid, 1, 128)
          && esActaIncidenciaValida(d.acta_incidencia)
          && cadena(d.creado_por_uid, 1, 128)
          && d.creado_en is timestamp
          && d.actualizado_en is timestamp
          && (!('creado_por_nombre' in d) || cadena(d.creado_por_nombre, 0, 200))
          && (!('operativo_nombre' in d) || cadena(d.operativo_nombre, 0, 120))
          && (!('cantidad' in d)
              || (d.cantidad is int && d.cantidad >= 1 && d.cantidad <= 99))
          && (!('ayudantia_slot' in d)
              || d.ayudantia_slot in ['Capacitación', 'Administración de Personal',
                                      'Tesla', 'Socorros', 'Logística', 'Ninguna']);
    }

    // -------------------------------------------------------------
    // Validador de dominio: evidencias_equipos (solo create)
    // -------------------------------------------------------------
    function esEvidenciaEquipoValida(d, evidenciaId) {
      let campos = ['id', 'equipo_id', 'asistencia_id', 'operativo_id',
                    'imagen_webp_base64', 'creado_por_uid', 'creado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == evidenciaId
          && cadena(d.equipo_id, 1, 128)
          && cadena(d.asistencia_id, 1, 128)
          && cadena(d.operativo_id, 1, 128)
          && d.imagen_webp_base64 is string
          && d.imagen_webp_base64.size() >= 50
          && d.imagen_webp_base64.size() <= 160000
          && d.imagen_webp_base64.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')
          && d.creado_por_uid == request.auth.uid
          && d.creado_en == request.time;
    }

    // -------------------------------------------------------------
    // Validador de dominio: canales_radio (create Y update)
    // -------------------------------------------------------------
    function esCanalRadioValido(d, canalId) {
      let campos = ['id', 'operativo_id', 'nombre_canal', 'frecuencia_etiqueta',
                    'unidades_participantes', 'creado_por', 'creado_por_uid',
                    'creado_en', 'actualizado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == canalId
          && cadena(d.operativo_id, 1, 128)
          && cadena(d.nombre_canal, 1, 80)
          && cadena(d.frecuencia_etiqueta, 0, 40)
          && d.unidades_participantes is list
          && d.unidades_participantes.size() <= 50
          && cadena(d.creado_por, 1, 200)
          && cadena(d.creado_por_uid, 1, 128)
          && d.creado_en is timestamp
          && d.actualizado_en is timestamp;
    }

    // -------------------------------------------------------------
    // Validador de dominio: bitacora_radio_registros (create Y update)
    // -------------------------------------------------------------
    function esRegistroBitacoraRadioValido(d, registroId) {
      let campos = ['id', 'canal_id', 'operativo_id', 'hora_original', 'origen',
                    'destinos', 'actividades', 'registrado_por',
                    'registrado_por_uid', 'fue_editado',
                    'actividad_original_respaldo', 'editado_en', 'editado_por',
                    'creado_en', 'actualizado_en'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == registroId
          && cadena(d.canal_id, 1, 128)
          && cadena(d.operativo_id, 1, 128)
          && cadena(d.hora_original, 8, 8)
          && d.hora_original.matches('^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$')
          && cadena(d.origen, 1, 80)
          && d.destinos is list
          && d.destinos.size() >= 1
          && d.destinos.size() <= 30
          && cadena(d.actividades, 1, 1000)
          && cadena(d.registrado_por, 1, 200)
          && cadena(d.registrado_por_uid, 1, 128)
          && d.fue_editado is bool
          && cadenaONull(d.actividad_original_respaldo, 1, 1000)
          && (d.editado_en == null || d.editado_en is timestamp)
          && cadenaONull(d.editado_por, 1, 200)
          && d.creado_en is timestamp
          && d.actualizado_en is timestamp;
    }

    // -------------------------------------------------------------
    // Validador de dominio: catalogo_claves (create Y update)
    // -------------------------------------------------------------
    function esClaveCatalogoValida(d, claveId) {
      let campos = ['id', 'tabla', 'codigo', 'significado', 'categoria',
                    'es_basico', 'orden'];
      return d.keys().hasAll(campos)
          && d.keys().hasOnly(campos)
          && d.id == claveId
          && d.tabla in ['codigos_1_100', 'claves_personales',
                         'alfabeto_fonetico', 'codigo_q', 'morse_banderolas']
          && cadena(d.codigo, 1, 30)
          && cadena(d.significado, 1, 250)
          && cadena(d.categoria, 0, 80)
          && d.es_basico is bool
          && d.orden is int
          && d.orden >= 0;
    }

    // =============================================================
    // usuarios/{uid}
    // =============================================================
    match /usuarios/{uid} {

      // Lectura individual: dueño siempre (evaluado primero para evitar get()),
      // Administrador Activo, Jefe de Ayudantía (solo su ayudantía),
      // o Encargado sin ayudantía (Opción B sobre Brigadistas de sus grupos_a_cargo).
      allow get: if esPropietario(uid) || puedeLeerUsuarioPorTercero();

      // Consultas (list): Administrador, Jefe de Ayudantía (solo su ayudantía),
      // o Encargado sin ayudantía restringido a Brigadistas de sus grupos_a_cargo.
      allow list: if puedeLeerUsuarioPorTercero();

      // Alta: solo el propio usuario, con esquema válido y valores iniciales
      // forzados sin auto-escalamiento.
      allow create: if esPropietario(uid)
                    && esUsuarioValido(request.resource.data, uid)
                    && tieneValoresIniciales(request.resource.data);

      // Actualización unificada (calcula camposCambiados() una sola vez y
      // evalúa adscripción -> autorización -> esUsuarioValido):
      // (a1) Dueño en estatus 'Pendiente' (corrección de datos de registro previos a aprobación)
      // (a2) Dueño en estatus 'Activo' (solo datos operativos/médicos no identitarios + tiene_foto)
      // (b) Jefe de Ayudantía Activo (exclusivo de su propia ayudantía, sin autoasignación)
      // (c) Encargado sin ayudantía Opción B (Brigadistas ajenos en grupos_a_cargo)
      // (d) Administrador Activo (campos privilegiados + corrección de identidad)
      allow update: if isSignedIn()
                    && request.resource.data.actualizado_en == request.time
                    && puedeActualizarUsuario(uid);

      // Nunca se eliminan usuarios (se dan de baja con estatus 'Inactivo').
      allow delete: if false;
    }

    // =============================================================
    // perfiles_operativos/{uid} — proyección mínima operativa
    // =============================================================
    match /perfiles_operativos/{uid} {

      // Lectura y listado: propio titular, Administrador Activo, Jefe de Ayudantía
      // (solo su ayudantía) o Encargado sin ayudantía Activo.
      allow get, list: if esPropietario(uid) || puedeLeerPerfilOperativoPorTercero();

      // Alta y actualización:
      // (a) Propio titular sin privilegios en alta inicial, recuperación de cuenta
      //     huérfana o mientras usuarios/{uid} permanezca en 'Pendiente' (cortocircuito
      //     previo a perfilPropio() para soportar writeBatch de alta inicial).
      // (b) Administrador Activo o Jefe de Ayudantía Activo (restringido a su ayudantía).
      allow create, update: if esPerfilOperativoValido(request.resource.data, uid)
                            && (puedeEscribirPerfilOperativoPropioPendiente(uid)
                                || puedeEscribirPerfilOperativo());

      // Nunca se eliminan proyecciones operativas.
      allow delete: if false;
    }

    // =============================================================
    // catalogos/{catalogoId} — catálogos configurables (ej. subgrupos)
    // =============================================================
    match /catalogos/{catalogoId} {

      // Lectura y listado: cualquier usuario con cuenta Activa.
      allow get, list: if esActivo();

      // Alta y actualización: solo Administrador Activo con esquema completo.
      allow create, update: if esAdminActivo()
                            && esCatalogoValido(request.resource.data, catalogoId);

      // Eliminación: solo Administrador Activo.
      allow delete: if esAdminActivo();
    }

    // =============================================================
    // incidencias_personal/{incidenciaId} — bitácora inmutable
    // =============================================================
    match /incidencias_personal/{incidenciaId} {

      // Lectura individual: Admin, Encargado creador, Jefe de Ayudantía (si el
      // usuario objetivo es de su ayudantía) o Encargado sin ayudantía (grupos_a_cargo).
      allow get: if puedeLeerIncidenciaGet();

      // Listado: Admin o Encargado Activo filtrado a sus propias incidencias.
      allow list: if esAdminActivo()
                  || (esEncargadoActivo()
                      && resource.data.creado_por_uid == request.auth.uid);

      // Alta: esquema válido + Admin, Jefe de Ayudantía (solo Brigadistas de su
      // ayudantía y operativo nulo o no finalizado) o Encargado sin ayudantía.
      allow create: if esIncidenciaPersonalValida(request.resource.data, incidenciaId)
                    && puedeCrearIncidencia(request.resource.data);

      // Inmutable: nunca se edita ni se elimina.
      allow update, delete: if false;
    }

    // =============================================================
    // auditoria_eventos/{eventoId} — bitácora inmutable
    // =============================================================
    match /auditoria_eventos/{eventoId} {

      // Solo un Administrador Activo puede consultar la bitácora.
      allow get, list: if esAdminActivo();

      // Cualquier usuario con cuenta Activa puede registrar un evento propio.
      allow create: if esActivo() && esEventoValido(request.resource.data);

      // Inmutable: nunca se edita ni se borra.
      allow update, delete: if false;
    }

    // =============================================================
    // fotos_perfiles/{uid} — foto de perfil WebP en base64
    // =============================================================
    match /fotos_perfiles/{uid} {

      // Lectura individual: el dueño (evaluado primero para evitar un get())
      // o cualquier usuario con cuenta Activa.
      allow get: if esPropietario(uid) || esActivo();

      // No se permite listar fotos de perfil en bloque.
      allow list: if false;

      // Alta y actualización: el dueño Activo o un Administrador Activo,
      // validando siempre el esquema completo y el formato WebP base64.
      allow create, update: if ((esPropietario(uid) && esActivo()) || esAdminActivo())
                            && esFotoPerfilValida(request.resource.data, uid);

      // Eliminación: el dueño Activo o un Administrador Activo.
      allow delete: if (esPropietario(uid) && esActivo()) || esAdminActivo();
    }

    // =============================================================
    // operativos/{operativoId} — operativos y eventos
    // =============================================================
    match /operativos/{operativoId} {

      // Lectura y listado: cualquier usuario con cuenta Activa.
      allow get, list: if esActivo();

      // Alta: Encargado o Administrador Activo, con esquema completo,
      // estatus inicial ausente o 'Activo', prerregistros_count ausente o 0,
      // autoría propia y timestamps del servidor.
      allow create: if esEncargadoOAdminActivo()
                    && esOperativoValido(request.resource.data, operativoId)
                    && (!('estatus' in request.resource.data)
                        || request.resource.data.estatus == 'Activo')
                    && (!('prerregistros_count' in request.resource.data)
                        || request.resource.data.prerregistros_count == 0)
                    && request.resource.data.creado_por_uid == request.auth.uid
                    && request.resource.data.creado_en == request.time
                    && request.resource.data.actualizado_en == request.time;

      // Actualización mientras el operativo NO esté Finalizado (cierre irreversible):
      // (a) Encargado o Administrador Activo (cortocircuito rápido): esquema válido
      //     e inmutables intactos.
      // (b) Brigadista Activo: únicamente ['prerregistros_count', 'actualizado_en']
      //     con atomicidad estricta respecto a su propio prerregistros/{uid}.
      allow update: if isSignedIn()
                    && resource.data.get('estatus', 'Activo') != 'Finalizado'
                    && request.resource.data.actualizado_en == request.time
                    && puedeActualizarOperativo(operativoId);

      // Eliminación: exclusiva de Administrador Activo.
      allow delete: if esAdminActivo();

      // -----------------------------------------------------------
      // operativos/{operativoId}/secretos/totp — secreto TOTP
      // -----------------------------------------------------------
      match /secretos/totp {

        // Lectura individual: cualquier usuario con cuenta Activa.
        allow get: if esActivo();

        // No se permite listar secretos.
        allow list: if false;

        // Alta y actualización: Encargado o Administrador Activo,
        // compatible con writeBatch junto al alta del operativo.
        allow create, update: if esEncargadoOAdminActivo()
                              && esSecretoTotpValido(request.resource.data);

        // Nunca se elimina el secreto TOTP.
        allow delete: if false;
      }

      // -----------------------------------------------------------
      // operativos/{operativoId}/prerregistros/{uid} — lista previa
      // -----------------------------------------------------------
      match /prerregistros/{uid} {

        // Lectura individual: propio usuario Activo (cortocircuito en 1 get()),
        // Administrador, Jefe de Ayudantía (solo su ayudantía) o Encargado sin ayudantía.
        allow get: if (esPropietario(uid) && esActivo())
                   || puedeLeerPrerregistroComoEncargadoOAdmin();

        // Listado: Administrador, Jefe de Ayudantía (filtrado a su ayudantía)
        // o Encargado sin ayudantía Activo.
        allow list: if puedeLeerPrerregistroComoEncargadoOAdmin();

        // Alta: esquema estricto + operativo existente y no Finalizado.
        // Admin, Jefe de Ayudantía (solo su ayudantía), Encargado sin ayudantía
        // o propio Brigadista Activo con 'Autoregistro' y convocatoria_abierta == true.
        allow create: if isSignedIn()
                      && esPrerregistroValido(request.resource.data, uid)
                      && request.resource.data.registrado_por_uid == request.auth.uid
                      && request.resource.data.fecha_registro == request.time
                      && (!('actualizado_en' in request.resource.data)
                          || request.resource.data.actualizado_en == request.time)
                      && puedeCrearPrerregistro(operativoId, uid);

        // Actualización controlada durante la convocatoria (operativo no Finalizado):
        // solo Admin Activo, Jefe de Ayudantía Activo (sobre su ayudantía vía
        // ayudantia o ayudantia_slot) o Encargado Activo sin ayudantía; valida
        // parcialmente únicamente rol_en_turno, rol_editado_manual y
        // actualizado_en == request.time para compatibilidad con históricos legacy.
        allow update: if isSignedIn()
                      && operativoNoFinalizado(operativoId)
                      && camposCambiados().hasOnly(['rol_en_turno',
                                                    'rol_editado_manual',
                                                    'actualizado_en'])
                      && request.resource.data.actualizado_en == request.time
                      && 'rol_en_turno' in request.resource.data
                      && esRolEnTurnoValido(request.resource.data.rol_en_turno)
                      && (!('rol_editado_manual' in request.resource.data)
                          || request.resource.data.rol_editado_manual is bool)
                      && puedeActualizarPrerregistroComoEncargadoOAdmin();

        // Baja: operativo existente y no Finalizado. Admin, Jefe de Ayudantía
        // (solo su ayudantía), Encargado sin ayudantía o propio usuario Activo
        // mientras convocatoria_abierta == true.
        allow delete: if isSignedIn()
                      && puedeEliminarPrerregistro(operativoId, uid);
      }
    }

    // =============================================================
    // asistencias_personal/{asistenciaId} — pase de lista y turnos
    // =============================================================
    match /asistencias_personal/{asistenciaId} {

      // Lectura y listado: propio usuario Activo (sus asistencias), Admin,
      // Jefe de Ayudantía (solo ayudantia_slot == su ayudantía) o Encargado sin ayudantía.
      allow get, list: if puedeLeerAsistencia();

      // Alta: requiere operativo no finalizado con recepción abierta.
      // Permitido para Admin, Jefe de Ayudantía (solo su ayudantia_slot),
      // Encargado sin ayudantía o auto-registro QR propio.
      allow create: if esAsistenciaValida(request.resource.data, asistenciaId)
                    && operativoConRecepcionAbierta(request.resource.data.operativo_id)
                    && request.resource.data.equipos_bupc_pendientes == 0
                    && request.resource.data.hora_salida == null
                    && request.resource.data.horas_totales == null
                    && request.resource.data.hora_entrada == request.time
                    && request.resource.data.creado_en == request.time
                    && request.resource.data.actualizado_en == request.time
                    && request.resource.data.registrado_por_uid == request.auth.uid
                    && puedeCrearAsistenciaPorRol();

      // Actualización unificada mientras el operativo no esté Finalizado
      // (incluso con recepción cerrada): evalúa operativoNoFinalizado y
      // esAsistenciaValida una sola vez.
      // (a) Dueño Activo: cierra su propia salida sin equipos BUPC pendientes.
      // (b) Admin / Jefe de Ayudantía (solo su ayudantia_slot) / Encargado sin ayudantía:
      //     rol, estado, signos, equipos_bupc_pendientes y salida respetando Candado Duro.
      allow update: if isSignedIn()
                    && operativoNoFinalizado(resource.data.operativo_id)
                    && request.resource.data.actualizado_en == request.time
                    && esAsistenciaValida(request.resource.data, asistenciaId)
                    && puedeActualizarAsistenciaPorRol();

      // Nunca se eliminan registros de asistencia.
      allow delete: if false;
    }

    // =============================================================
    // equipos_turno/{equipoId} — equipo BUPC asignado y propio
    // =============================================================
    match /equipos_turno/{equipoId} {

      // Lectura y listado: el propio brigadista Activo o Encargado/Admin Activo.
      allow get, list: if (esActivo() && resource.data.usuario_uid == request.auth.uid)
                       || esEncargadoOAdminActivo();

      // Alta unificada mientras el operativo no esté Finalizado:
      // Admin / Encargado sin ayudantía / Jefe de Ayudantía (solo asistencias de
      // su ayudantía) o brigadista Activo (solo Material Propio).
      allow create: if isSignedIn()
                    && operativoNoFinalizado(request.resource.data.operativo_id)
                    && esEquipoTurnoValido(request.resource.data, equipoId)
                    && request.resource.data.devuelto == false
                    && request.resource.data.acta_incidencia == null
                    && request.resource.data.creado_por_uid == request.auth.uid
                    && request.resource.data.creado_en == request.time
                    && request.resource.data.actualizado_en == request.time
                    && (puedeGestionarEquipoComoEncargadoOAdmin(request.resource.data.asistencia_id)
                        || (esActivo()
                            && request.resource.data.usuario_uid == request.auth.uid
                            && request.resource.data.origen_material == 'Propio'
                            && request.resource.data.estado_reporte in ['OK', 'Con_Falla']));

      // Actualización unificada mientras el operativo no esté Finalizado:
      // (a) Admin / Encargado sin ayudantía / Jefe de Ayudantía (solo asistencias
      //     de su ayudantía): reporte, devolución o acta de incidencia.
      // (b) Brigadista Activo: solo reporte OK o Con_Falla sin devolución ni acta.
      allow update: if isSignedIn()
                    && operativoNoFinalizado(resource.data.operativo_id)
                    && request.resource.data.actualizado_en == request.time
                    && esEquipoTurnoValido(request.resource.data, equipoId)
                    && (
                      (puedeGestionarEquipoComoEncargadoOAdmin(resource.data.asistencia_id)
                       && camposCambiados().hasOnly(['estado_reporte', 'falla_reportada',
                                                     'devuelto', 'devuelto_en',
                                                     'devuelto_por_uid', 'acta_incidencia',
                                                     'actualizado_en']))
                      || (esActivo()
                          && resource.data.usuario_uid == request.auth.uid
                          && resource.data.devuelto == false
                          && resource.data.acta_incidencia == null
                          && camposCambiados().hasOnly(['estado_reporte', 'falla_reportada',
                                                        'actualizado_en'])
                          && request.resource.data.estado_reporte in ['OK', 'Con_Falla'])
                    );

      // Nunca se eliminan registros de equipo en turno.
      allow delete: if false;
    }

    // =============================================================
    // evidencias_equipos/{evidenciaId} — fotos WebP de actas (inmutable)
    // =============================================================
    match /evidencias_equipos/{evidenciaId} {

      // Lectura individual: solo Encargado o Administrador Activo.
      allow get: if esEncargadoOAdminActivo();

      // No se permite listar evidencias en bloque.
      allow list: if false;

      // Alta: solo Encargado o Administrador Activo mientras el operativo
      // no esté Finalizado (compatible con runTransaction).
      allow create: if esEncargadoOAdminActivo()
                    && operativoNoFinalizado(request.resource.data.operativo_id)
                    && esEvidenciaEquipoValida(request.resource.data, evidenciaId);

      // Inmutable: nunca se edita ni se elimina.
      allow update, delete: if false;
    }

    // =============================================================
    // canales_radio/{canalId} — canales de radiocomunicación
    // =============================================================
    match /canales_radio/{canalId} {

      // Lectura y listado: Administrador Activo o usuario Activo con autorizado_radio == true.
      allow get, list: if puedeUsarRadio();

      // Alta: usuario con permiso de radio, esquema completo, operativo no
      // finalizado, autoría propia y marcas de tiempo del servidor.
      allow create: if puedeUsarRadio()
                    && esCanalRadioValido(request.resource.data, canalId)
                    && operativoNoFinalizado(request.resource.data.operativo_id)
                    && request.resource.data.creado_por_uid == request.auth.uid
                    && request.resource.data.creado_en == request.time
                    && request.resource.data.actualizado_en == request.time;

      // Actualización: solo mientras el operativo no esté Finalizado; permite
      // únicamente unidades_participantes, frecuencia_etiqueta y
      // actualizado_en == request.time; el resto permanece inmutable.
      allow update: if puedeUsarRadio()
                    && operativoNoFinalizado(resource.data.operativo_id)
                    && camposCambiados().hasOnly(['unidades_participantes',
                                                  'frecuencia_etiqueta',
                                                  'actualizado_en'])
                    && request.resource.data.actualizado_en == request.time
                    && esCanalRadioValido(request.resource.data, canalId);

      // Nunca se eliminan canales de radio.
      allow delete: if false;
    }

    // =============================================================
    // bitacora_radio_registros/{registroId} — bitácora de radio
    // =============================================================
    match /bitacora_radio_registros/{registroId} {

      // Lectura y listado: Administrador Activo o usuario Activo con autorizado_radio == true.
      allow get, list: if puedeUsarRadio();

      // Alta: usuario con permiso de radio, esquema válido, operativo no
      // finalizado, autoría propia, sin marcas de edición previa y marcas de
      // tiempo del servidor.
      allow create: if puedeUsarRadio()
                    && esRegistroBitacoraRadioValido(request.resource.data, registroId)
                    && operativoNoFinalizado(request.resource.data.operativo_id)
                    && request.resource.data.registrado_por_uid == request.auth.uid
                    && request.resource.data.fue_editado == false
                    && request.resource.data.actividad_original_respaldo == null
                    && request.resource.data.editado_en == null
                    && request.resource.data.editado_por == null
                    && request.resource.data.creado_en == request.time
                    && request.resource.data.actualizado_en == request.time;

      // Actualización controlada (INMUTABILIDAD CRÍTICA):
      // solo mientras el operativo no esté Finalizado; hora_original nunca
      // cambia y solo puede corregirse actividades dejando respaldo obligatorio
      // y rastro de auditoría de edición.
      allow update: if puedeUsarRadio()
                    && operativoNoFinalizado(resource.data.operativo_id)
                    && esRegistroBitacoraRadioValido(request.resource.data, registroId)
                    && request.resource.data.hora_original == resource.data.hora_original
                    && camposCambiados().hasOnly(['actividades', 'fue_editado',
                                                  'actividad_original_respaldo',
                                                  'editado_en', 'editado_por',
                                                  'actualizado_en'])
                    && request.resource.data.fue_editado == true
                    && request.resource.data.actividad_original_respaldo != null
                    && request.resource.data.editado_en == request.time
                    && request.resource.data.editado_por is string
                    && request.resource.data.editado_por.size() >= 1
                    && request.resource.data.actualizado_en == request.time;

      // Inmutable: nunca se eliminan registros de bitácora de radio.
      allow delete: if false;
    }

    // =============================================================
    // catalogo_claves/{claveId} — 5 tablas del catálogo ReBaCE v2
    // =============================================================
    match /catalogo_claves/{claveId} {

      // Lectura y listado: Administrador Activo o usuario Activo con autorizado_radio == true.
      allow get, list: if puedeUsarRadio();

      // Alta y actualización: solo Administrador Activo con esquema completo.
      allow create, update: if esAdminActivo()
                            && esClaveCatalogoValida(request.resource.data, claveId);

      // Eliminación: solo Administrador Activo.
      allow delete: if esAdminActivo();
    }

    // Todo lo demás está denegado por defecto (no hay más reglas "allow").
  }
}
